import tkinter as tk
from tkinter import ttk
import socket
import threading
import time

class FiveScanner:
    def __init__(self, root):
        self.root = root
        self.root.title("FIVE SCANNER - Target Intelligence")
        self.root.geometry("500x600")
        self.root.configure(bg="#050505")

        # --- LOGO ASCII ---
        self.logo = """
  ___________.___ ____   ____ ___________
  \_   _____/|   |\   \ /   / \_   _____/
   |    __)  |   | \   Y   /   |    __)_ 
   |     \   |   |  \     /    |        \ 
   \___  /   |___|   \___/    /_______  /
       \/                             \/ 
        SCANNER MODULE v1.0
        """
        tk.Label(root, text=self.logo, font=("Consolas", 8), fg="#00ff00", bg="#050505").pack(pady=10)

        # --- INPUTS ---
        self.container = tk.Frame(root, bg="#050505")
        self.container.pack(pady=10, padx=50, fill='x')

        tk.Label(self.container, text="TARGET HOST (IP/URL):", fg="#555", bg="#050505", font=("Arial", 8, "bold")).pack(anchor='w')
        self.target_ent = tk.Entry(self.container, bg="#111", fg="#00ff00", borderwidth=0, justify="center")
        self.target_ent.insert(0, "127.0.0.1")
        self.target_ent.pack(pady=5, fill='x', ipady=5)

        # PRZYCISK SCAN
        self.scan_btn = tk.Button(root, text="START SCAN", bg="#00ff00", fg="black", font=("Impact", 18), 
                                  activebackground="#008800", relief="flat", command=self.start_scan)
        self.scan_btn.pack(pady=20, padx=50, fill='x')

        # LOGI / WYNIKI
        self.result_box = tk.Text(root, height=15, bg="#000", fg="#00ff00", font=("Consolas", 9), borderwidth=0)
        self.result_box.pack(pady=5, padx=20, fill='both')

    def log(self, msg):
        self.result_box.insert(tk.END, f"[+] {msg}\n")
        self.result_box.see(tk.END)

    def start_scan(self):
        self.result_box.delete('1.0', tk.END)
        threading.Thread(target=self.run_scanner, daemon=True).start()

    def run_scanner(self):
        target = self.target_ent.get()
        self.log(f"INITIATING RECONNAISSANCE ON: {target}")
        
        # Symulacja sprawdzania DNS i Geografii
        try:
            ip = socket.gethostbyname(target)
            self.log(f"RESOLVED IP: {ip}")
        except:
            self.log("CANNOT RESOLVE HOST.")
            return

        # Lista najpopularniejszych portów do sprawdzenia
        ports = [21, 22, 80, 443, 3306, 8080, 25565]
        
        for port in ports:
            self.log(f"CHECKING PORT {port}...")
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(0.5)
            result = sock.connect_ex((ip, port))
            if result == 0:
                self.log(f"!!! PORT {port} IS OPEN !!!")
            sock.close()
            time.sleep(0.1)

        self.log("RECON COMPLETED. TARGET ANALYZED.")

if __name__ == "__main__":
    root = tk.Tk()
    app = FiveScanner(root)
    root.mainloop()
